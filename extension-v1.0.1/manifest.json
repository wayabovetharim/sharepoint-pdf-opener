{
  "manifest_version": 3,
  "name": "SharePoint PDF Opener",
  "version": "1.0.0",
  "description": "Automatically opens SharePoint PDF files in Adobe Acrobat instead of the browser viewer.",

  "permissions": [
    "downloads",
    "downloads.open",
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "webRequest",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "*://*.sharepoint.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.sharepoint.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["intercept.html"],
      "matches": ["*://*.sharepoint.com/*"]
    }
  ]
}
